# Copy this file to .env.local and fill in real values. .env.local is
# gitignored — never commit real secrets or URLs here in .env.example.

# Phase 2: base URL of the NestJS backend once it exists.
# Until then, lib/api/* read from lib/mock-data and this is unused.
NEXT_PUBLIC_API_URL=http://localhost:4000/api

